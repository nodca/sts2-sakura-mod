[sub_resource type="Shader" id="Shader_medallion"]
code = "shader_type canvas_item;\n\n// Lit medallion: the element's light drifting through the plate, a light-up reveal\n// from the centre, and a trigger flash. flow_strength is 0 with card VFX off.\nuniform sampler2D flow_noise : repeat_enable, filter_linear;\nuniform vec4 element_color : source_color = vec4(1.0);\nuniform float flow_strength : hint_range(0.0, 1.0) = 1.0;\nuniform float light_progress : hint_range(0.0, 1.0) = 1.0;\nuniform float flash : hint_range(0.0, 1.0) = 0.0;\n\nvoid fragment() {\n    vec4 base = COLOR;\n    float n = texture(flow_noise, UV * 0.8 + vec2(TIME * 0.04, -TIME * 0.07)).r;\n    float m = texture(flow_noise, UV * 1.6 + vec2(-TIME * 0.06, TIME * 0.03)).r;\n    float drift = smoothstep(0.5, 0.85, n * 0.6 + m * 0.4) * flow_strength;\n    vec3 colour = base.rgb + element_color.rgb * drift * 0.3;\n    // The disc ends at 0.45 UV, so reach stays below the front once light_progress is 1.\n    float reach = length(UV - vec2(0.5)) * 1.7 + (n - 0.5) * 0.3;\n    float front = light_progress * 1.15;\n    float shown = 1.0 - smoothstep(front - 0.04, front, reach);\n    float edge = shown * smoothstep(front - 0.16, front - 0.02, reach) * (1.0 - step(0.999, light_progress));\n    colour = mix(colour, vec3(1.0), clamp(edge * 0.8 + flash * 0.45, 0.0, 1.0));\n    COLOR = vec4(colour, base.a * shown);\n}\n"

[sub_resource type="Shader" id="Shader_sheen"]
code = "shader_type canvas_item;\n\n// A diagonal band sweeps the board's gold every few seconds, confined to the gold by\n// sheen_mask. sheen_strength is 0 with card VFX off.\nuniform sampler2D sheen_mask : filter_linear;\nuniform float sheen_strength : hint_range(0.0, 1.0) = 1.0;\nconst float PERIOD = 5.5;\n\nvoid fragment() {\n    vec4 base = COLOR;\n    float mask = texture(sheen_mask, UV).a;\n    float sweep = fract(TIME / PERIOD) * 2.2 - 0.6;\n    float band = 1.0 - smoothstep(0.0, 0.07, abs((UV.x + UV.y) * 0.5 - sweep));\n    base.rgb += vec3(1.0, 0.96, 0.78) * band * mask * sheen_strength * 0.6;\n    COLOR = base;\n}\n"

[sub_resource type="Shader" id="Shader_glow"]
code = "shader_type canvas_item;\nrender_mode blend_add;\n\n// Medallion glow, breathing slowly. breath is 0 with card VFX off, which holds it steady.\nuniform float breath : hint_range(0.0, 1.0) = 1.0;\n\nvoid fragment() {\n    float pulse = 0.72 + 0.28 * sin(TIME * 2.2);\n    COLOR.a *= mix(0.85, pulse, breath);\n}\n"

[sub_resource type="FastNoiseLite" id="FastNoiseLite_flow"]
