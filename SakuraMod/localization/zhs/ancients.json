{
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.title": "大道寺知世",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.epithet": "服装设计师",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.firstVisitEver.0-0.ancient": "小樱，终于找到你了！我还带来了几套专门为你准备的战斗服。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.firstVisitEver.0-0.next": "倾听",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.firstVisitEver.0-1.char": "知世？你怎么会在这里？",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.firstVisitEver.0-1.next": "询问",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.firstVisitEver.0-2.ancient": "这些都是我为你制作的。选一套最符合你心中牌组的战斗服吧。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient": "小樱，你穿什么都好看！我们先拍哪一套呢？",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient": "刚才小可偷吃茶点的样子我也一并录下来了哦，作为战前花絮真是太珍贵了呢。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.next": "害羞",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.char": "知世……别连小可抢点心也拍进去啦！",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.next": "继续",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-2r.ancient": "呼呼，只要有小樱在的地方，每一帧都是最棒的画面呀。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0r.ancient": "塔里的大家穿着风格都好特别呢……不过果然还是小樱最可爱！",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0r.next": "感谢",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1r.char": "谢谢你总是带着这些衣服来找我，知世！",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-visit": "2",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.talk.ANY.0-0r.ancient": "一套合适的服装，能让勇敢的心变得更加勇敢。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.pages.INITIAL.description": "知世展示了三套精心准备的战斗服。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.pages.DONE.description": "知世挥手道别，选中的战斗服完美地贴合在身上。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.pages.INITIAL.options.SAKURA_MOD_RELIC_CLASSIC_RED_CAPE_RELIC.title": "选择库洛牌战斗服。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.pages.INITIAL.options.SAKURA_MOD_RELIC_CLASSIC_RED_CAPE_RELIC.description": "获得红披风战斗服。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.pages.INITIAL.options.SAKURA_MOD_RELIC_CLASSIC_PINK_TRANSFORMATION_COSTUME_RELIC.title": "选择小樱牌战斗服。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.pages.INITIAL.options.SAKURA_MOD_RELIC_CLASSIC_PINK_TRANSFORMATION_COSTUME_RELIC.description": "获得粉色战斗服。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.pages.INITIAL.options.SAKURA_MOD_RELIC_CLASSIC_FROG_RAINCOAT_RELIC.title": "选择透明牌战斗服。",
  "SAKURA_MOD_EVENT_CLASSIC_TOMOYO_ANCIENT_COSTUMES.pages.INITIAL.options.SAKURA_MOD_RELIC_CLASSIC_FROG_RAINCOAT_RELIC.description": "获得青蛙雨衣。",

  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient": "[sine]...星光... ..与陌生的.. ..魔法.....\n...小家伙... ..你不是... 这里的... ..战士....[/sine]",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.next": "回答",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.char": "那个……请问这里是高塔的下面吗？我好像和大家走散了……",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.next": "倾听",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient": "[sine]...迷途的... ..持有者...\n...收下.. 我的.. ..赐福... ..向上... ..去吧....[/sine]",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient.sfx": "event:/sfx/npcs/neow/neow_welcome",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient": "[sine]...你的心中... ..几乎没有... ..怨恨....\n...真是.. ..奇怪的... ..力量....[/sine]",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.next": "解释",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.char": "因为我并不想伤害谁呀……只是想快点找到大家，一起回家。",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient": "[sine]...又醒来... ..了吗....\n...杀死... [red][jitter]建筑师[/jitter][/red]... ...才能.. ..结束....[/sine]",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.next": "回应",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.char": "好可怕的气息……不过如果是必须解决的异变，绝对没问题的！",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.next": "倾听",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient": "[sine]...耀眼得... ..令人.. 怀念...\n...去吧... ...我的... ..小小.. 旅人....[/sine]",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient.sfx": "event:/sfx/npcs/neow/neow_welcome",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient": "[sine]...那根... ..钥匙模样的... ..法杖...\n...正在... ..呼应.. 高塔的... ..记忆....[/sine]",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "NEOW.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-visit": "2",

  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient": "哎呀呀！小姑娘，你背着的那本硬壳书居然还在发光吶！\n让达弗看看，这里面藏着什么好宝贝呀！？",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient.sfx": "event:/sfx/npcs/darv/darv_introduction",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.next": "解释",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.char": "啊，不行不行！封印之书里的牌不可以随便送人的！",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.next": "倾听",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient": "好吧好吧，真是护短的小家伙！\n那反过来，你从我这堆亮闪闪里挑一件带走总行了吧！！",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient.sfx": "event:/sfx/npcs/darv/darv_endeared",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient": "哇，你肩膀旁边飘着的那个黄色小绒毛球……该不会也是活的魔法收藏品吧！？",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.next": "解释",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.char": "[i][font_size=22]可鲁贝洛斯警惕地抱住自己的小蛋糕，往小樱身后躲了半步。[/font_size][/i]",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.next": "继续",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-2r.ancient": "哈哈！放心放心，我才不抢小朋友的伙伴呢，来挑个遗物吧！",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-2r.ancient.sfx": "event:/sfx/npcs/darv/darv_endeared",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient": "我其实捡到过一张透明得像玻璃一样的卡片，上面写着奇怪的图案……\n可惜一碰建筑师那边的魔力就碎掉了，呃……唔。",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient.sfx": "event:/sfx/npcs/darv/darv_fear",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.next": "询问",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.char": "透明的卡片……？难道这里也有魔力失控的牌吗？",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.next": "倾听",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient": "当我没说，当我没说！！你还是赶紧挑完东西往上走吧！",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient.sfx": "event:/sfx/npcs/darv/darv_fear",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient": "魔杖！卡牌！还有亮晶晶的星星徽章！\n你们魔法少女的装备真是太适合放进藏品架啦！",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-visit": "2",

  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient": "哇啊！！会发光的小棍子！！还会变成星星！！\n还有会飞的卡片！！怎么变出来的？？快再变一次！！",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.next": "解释",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.char": "诶嘿嘿，这是我的魔法啦！你要看的话，我抽一张给你看哦！",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.next": "畅谈",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient": "好厉害！！亮闪闪的！！一点也不可怕！！\n这个送你！最喜欢不爱打架的新朋友了！！",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient": "讲故事时间到了！！\n那个金黄色的、喜欢吃甜点的小狮子今天有没有一起去冒险！？",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.next": "聊天",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.char": "小可他刚刚还在抱怨这里没有布丁和章鱼烧呢……",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.next": "继续",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-2r.ancient": "布丁是什么！？听起来就软绵绵亮晶晶的！！收下这个，下次带布丁来给我看！！",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient": "塔顶的建筑师，其实很久以前也喜欢做各种各样的漂亮东西！\n只是后来变得好孤单……",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.next": "回答",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.char": "孤单吗……那等我见到他的时候，先试着和他好好说说话吧！",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.next": "继续",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient": "说话很好！！比打架好太多了！！加油啊魔法女孩！！",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient": "好多张牌叠在一起的时候，颜色就像彩虹一样！！\n跟我好像！！挑一件最喜欢的走吧！！",
  "OROBAS.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-visit": "2",

  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient": "[thinky_dots]多温暖的魔力……就像还没醒来的温柔梦境……\n小魔法师，你的梦里装着谁呢……？[/thinky_dots]",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.next": "回答",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.char": "大家都在等我回去……所以就算在梦里，我也要往前走。",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.next": "倾听",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient": "[thinky_dots]真是个温柔的孩子……\n拿走我的一部分吧，让它替你挡住风雪……[/thinky_dots]",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient": "[i][font_size=22]佩尔发出轻柔而沉重的呼噜声，小樱也忍不住跟着打了个小小的哈欠。[/font_size][/i]",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.next": "轻声道谢",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.char": "呜……差一点就要睡着了……得快点打起精神来！",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient": "[thinky_dots]你的卡片里，有“睡”与“梦”的回声……\n如果去到塔顶，请不要弄疼[red]父亲[/red]……[/thinky_dots]",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.next": "回答",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.char": "嗯，我答应你！一定会有不用伤害任何人的办法的。",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.next": "倾听",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient": "[thinky_dots]真好呀……要是父亲也能像你一样做个好梦就好了……zZZzz……[/thinky_dots]",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient": "[thinky_dots]时间与记忆都会令人疲惫……\n累了的话，就拿走一些我的力量再休息一会儿吧……[/thinky_dots]",
  "PAEL.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-visit": "2",

  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient": "哎呀呀，真是个有礼貌的可爱小姑娘！\n外头又冷又黑，快进来尝尝我刚烤好的[jitter][b]小点心[/b][/jitter]吧！",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.next": "感谢",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.char": "哇，好香的味道！谢谢老奶奶！您也喜欢做松饼和烤饼干吗？",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.next": "继续",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient": "呼呼……我可是用最旺的[jitter][b]炉火[/b][/jitter]慢慢烘焙的哟。\n小可爱，多吃一点才有力气往前走嘛！",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient": "来来，把牌组里你不喜欢的灰尘都交给我，让我帮你[jitter][b]烧个干净[/b][/jitter]吧！",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.next": "回应",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.char": "虽然觉得那团火有点吓人……不过谢谢您的好意！",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient": "你身上那股光芒和火焰的气息，让我想起以前见过的某位了不起的大人物呢……",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.next": "询问",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.char": "大人物？难道您认识库洛·里多先生吗……？",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.next": "倾听",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient": "谁知道呢～等哪天你不赶时间了，留下来陪我[jitter][b]喝茶[/b][/jitter]的时候再告诉你吧！",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient": "每次见你都这么精神满满，连我的炉火都要被你比下去啦！\n快来看看今天需要什么帮助吧，亲爱的！",
  "TEZCATARA.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-visit": "2",

  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient": "哎呀，总算来了位真正懂得[sine]品味[/sine]的访客！\n这精致的缎带与裙摆，是谁为你缝制出这么可爱的战衣？",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.next": "回答",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.char": "这是我最要好的朋友知世亲手为我做的战斗服！厉害吧！",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.next": "倾听",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient": "太有眼光了！像你这样精致的小淑女，当然也配得上我最上等的赐福。",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_giggle",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient": "仆人们，快为这位小魔法师倒上最香醇的红茶，再配一碟草莓小蛋糕！",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.next": "感谢",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.char": "谢谢诺奴佩普小姐！茶和蛋糕都好好吃！",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient": "建筑师把高塔造得灰扑扑的，半点浪漫和美感都没有！\n只有你的魔法和衣裙还像花朵一样亮眼呢。",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_eeked",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.next": "回应",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.char": "如果大家都能开开心心地穿漂亮的衣服就好了呢……",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.next": "继续",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient": "说得太对了！去吧，穿得漂漂亮亮地把阴霾一扫而空！",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_giggle",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient": "你的好友真是一位了不起的设计师……\n下次记得也带一件礼物，好让我好好鉴赏一番！",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "NONUPEIPE.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-visit": "2",

  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient": "[b]小不点！！你手里那根长着小翅膀的粉色棍子算什么武器！？\n能敲碎敌人的盔甲吗！？[/b]",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_curiosity",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.next": "解释",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.char": "这、这不是用来敲人的棍子，是封印之杖啦！它可以召唤“剑”和各种魔法！",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.next": "继续",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient": "[b]能变出剑吗！？那还不算太差！！收下这把真家伙再去打！！[/b]",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_laugh",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient": "[b]别光吹风放水了！！光靠卡牌怎么够痛快，选一件强力武器！！[/b]",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient": "[b]木之本樱，与我一战！！[/b]",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.next": "战斗",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.char": "[i][font_size=22]小樱急忙举起法杖用“盾”接下了坦克斯的猛击，还顺手塞过去一颗糖果。[/font_size][/i]",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.next": "继续",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient": "[b]连这一拳都[jitter]挡住了[/jitter]！？而且这甜丝丝的东西……力量涌上来了！！好！！[/b]",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_laugh",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient": "[b]那只金色的小飞兽呢！？让它也出来和我比划比划！！[/b]",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient.sfx": "event:/sfx/npcs/tanx/tanx_curiosity",
  "TANX.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-visit": "2",

  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.ancient": "真是稀奇……竟有一颗毫无阴翳的灵魂闯进了这被诅咒的墙内。\n迷路的小姑娘，想不想立刻回到你温暖的家呀？",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.next": "警惕",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.char": "爸爸、哥哥还有大家都在等我……但雪兔哥和知世说过，不能随便答应奇怪的交易！",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.next": "继续",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.ancient": "警惕心倒是不小呢。[sine]没关系[/sine]……等你感到无能为力时，契约的大门永远为你敞开。",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient": "[i][font_size=22]瓦库抖开一卷散发黑气的契约，小樱怀里的光与暗之牌同时发出了微微共鸣。[/font_size][/i]",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.next": "回绝",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.char": "就算借用力量，我也只要属于我和牌的星之力量！",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.ancient": "你心里最怕失去的究竟是什么？是朋友的笑容，还是再也回不去的日常？\n把名字签在这里，我就能替你永远锁住那一刻哦。",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0.next": "回绝",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.char": "不可以！大家向前迈进的回忆，才不是用来锁进契约里的东西！",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1.next": "继续",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2.ancient": "真是固执得令人发笑……那我就看看你的“[sine]绝对没问题[/sine]”能撑到几时吧。",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient": "你身上明明也带着黑暗与虚无的气息，却非要装出光明正大的模样吗？\n来吧，哪怕只是一小笔交易……",
  "VAKUU.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-visit": "2",

  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.char": "你就是这里的创造者吗？为什么要让大家在尖塔里一直战斗呢……",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-0.next": "询问",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.ancient": "高塔需要秩序，而外来者只需遵循规则。",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-1.next": "回应",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-2.char": "如果这是场失控的异变，我一定要找到把大家送回去的方法！",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.0-attack": "Both",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.ancient": "你眼中既无复仇，也无执念。为何一次次站到我面前？",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-0r.next": "回答",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.char": "因为大家一直被困在这里战斗太辛苦了！而且……我也想解开你的心结。",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-1r.next": "继续",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-2r.ancient": "天真得可笑。",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.1-attack": "Both",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0r.char": "就算每次都要从头再来，我也不会放弃的！",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-0r.next": "询问",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1r.ancient": "温暖的魔法，却救不了任何人。",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-1r.next": "回应",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-2r.char": "就算力量很小，我也要试一试！因为……绝对没问题的！",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.2-attack": "Both",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.ancient": "星辰、元素、梦与时间的卡片……此地容不下多余的奇迹。",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-0r.next": "反驳",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-1r.char": "这不是多余的奇迹——这是大家借给我的勇气！",
  "THE_ARCHITECT.talk.SAKURA_MOD_CHARACTER_CLASSIC_SAKURA.3-attack": "Both"
}
